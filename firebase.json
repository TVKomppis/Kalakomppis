{
  "hosting": [
    {
      "site": "kalakomppis",
      "public": ".",
      "ignore": [
        "firebase.json",
        ".firebaserc",
        "**/.*",
        "**/node_modules/**",
        "kotisivu/**",
        "LICENSE",
        "README.md"
      ],
      "headers": [
        {
          "source": "/@(index.html|sw.js|config.js|manifest.json)",
          "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
        }
      ]
    }
  ]
}
