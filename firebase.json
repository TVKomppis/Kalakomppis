{
  "hosting": [
    {
      "site": "kalakomppis",
      "public": ".",
      "ignore": [
        "firebase.json",
        ".firebaserc",
        "**/.*",
        "**/node_modules/**",
        "kotisivu/**",
        "LICENSE",
        "README.md"
      ],
      "headers": [
        {
          "source": "/@(index.html|sw.js|config.js|manifest.json)",
          "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
        }
      ]
    },
    {
      "site": "kalakomppis-koti",
      "public": "kotisivu",
      "trailingSlash": false,
      "ignore": [
        "**/.*",
        "*.py",
        "*.json",
        "*.md",
        "*.tpl.html",
        "*.svgfrag",
        "kuvakaappaukset.js",
        "guy.svg"
      ],
      "rewrites": [
        { "source": "/@(fi|sv|en)", "destination": "/index.html" }
      ],
      "headers": [
        {
          "source": "/index.html",
          "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
        },
        {
          "source": "/img/**",
          "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }]
        }
      ]
    }
  ]
}
